{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ExerciseType": {
      "type": "string",
      "enum": [
        "weight_reps",
        "reps_only",
        "weighted_bodyweight",
        "assisted_bodyweight",
        "duration",
        "duration_weight",
        "distance_duration",
        "weight_distance"
      ]
    },
    "EntryVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_at_ms", "writer"],
      "properties": {
        "changed_at_ms": { "type": "integer", "minimum": 0 },
        "writer": { "type": "string", "enum": ["phone", "watch"] }
      }
    },
    "VersionedNullableString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "value"],
      "properties": {
        "version": { "$ref": "#/definitions/EntryVersion" },
        "value": { "type": ["string", "null"] }
      }
    },
    "VersionedString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "value"],
      "properties": {
        "version": { "$ref": "#/definitions/EntryVersion" },
        "value": { "type": "string" }
      }
    },
    "VersionedNullableInteger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "value"],
      "properties": {
        "version": { "$ref": "#/definitions/EntryVersion" },
        "value": { "type": ["integer", "null"] }
      }
    },
    "VersionedNullableNumber": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "value"],
      "properties": {
        "version": { "$ref": "#/definitions/EntryVersion" },
        "value": { "type": ["number", "null"] }
      }
    },
    "ActiveWorkoutFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routine_id", "routine_structure_version", "name", "notes", "bodyweight_kg"],
      "properties": {
        "routine_id": { "$ref": "#/definitions/VersionedNullableString" },
        "routine_structure_version": { "$ref": "#/definitions/VersionedNullableInteger" },
        "name": { "$ref": "#/definitions/VersionedString" },
        "notes": { "$ref": "#/definitions/VersionedNullableString" },
        "bodyweight_kg": { "$ref": "#/definitions/VersionedNullableNumber" }
      }
    },
    "WorkoutExerciseFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercise_id",
        "exercise_name",
        "source_routine_exercise_id",
        "superset_group_id",
        "exercise_type",
        "notes"
      ],
      "properties": {
        "exercise_id": { "type": "string" },
        "exercise_name": { "type": "string" },
        "source_routine_exercise_id": { "type": ["string", "null"] },
        "superset_group_id": { "type": ["string", "null"] },
        "exercise_type": { "$ref": "#/definitions/ExerciseType" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "LoggedSetFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_routine_set_id",
        "set_type",
        "weight",
        "reps",
        "duration_seconds",
        "distance_meters",
        "rpe",
        "completed",
        "completed_at_ms"
      ],
      "properties": {
        "source_routine_set_id": { "type": ["string", "null"] },
        "set_type": { "type": "string", "enum": ["normal", "warmup", "dropset", "failure"] },
        "weight": { "type": ["number", "null"] },
        "reps": { "type": ["integer", "null"] },
        "duration_seconds": { "type": ["integer", "null"] },
        "distance_meters": { "type": ["number", "null"] },
        "rpe": { "type": ["number", "null"] },
        "completed": { "type": "boolean" },
        "completed_at_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "ActiveLoggedSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "deleted", "position", "value"],
      "properties": {
        "id": { "type": "string" },
        "version": { "$ref": "#/definitions/EntryVersion" },
        "deleted": { "type": "boolean" },
        "position": { "type": ["integer", "null"] },
        "value": {
          "oneOf": [{ "$ref": "#/definitions/LoggedSetFields" }, { "type": "null" }]
        }
      }
    },
    "ActiveWorkoutExercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "deleted", "position", "value", "sets"],
      "properties": {
        "id": { "type": "string" },
        "version": { "$ref": "#/definitions/EntryVersion" },
        "deleted": { "type": "boolean" },
        "position": { "type": ["integer", "null"] },
        "value": {
          "oneOf": [{ "$ref": "#/definitions/WorkoutExerciseFields" }, { "type": "null" }]
        },
        "sets": {
          "type": "array",
          "items": { "$ref": "#/definitions/ActiveLoggedSet" }
        }
      }
    },
    "ActiveWorkoutBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "exercises"],
      "properties": {
        "fields": { "$ref": "#/definitions/ActiveWorkoutFields" },
        "exercises": {
          "type": "array",
          "items": { "$ref": "#/definitions/ActiveWorkoutExercise" }
        }
      }
    },
    "LoggedSetBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_routine_set_id",
        "set_type",
        "weight",
        "reps",
        "duration_seconds",
        "distance_meters",
        "rpe",
        "completed",
        "completed_at_ms"
      ],
      "properties": {
        "id": { "type": "string" },
        "source_routine_set_id": { "type": ["string", "null"] },
        "set_type": { "type": "string", "enum": ["normal", "warmup", "dropset", "failure"] },
        "weight": { "type": ["number", "null"] },
        "reps": { "type": ["integer", "null"] },
        "duration_seconds": { "type": ["integer", "null"] },
        "distance_meters": { "type": ["number", "null"] },
        "rpe": { "type": ["number", "null"] },
        "completed": { "type": "boolean" },
        "completed_at_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "WorkoutExerciseBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "exercise_id",
        "exercise_name",
        "source_routine_exercise_id",
        "superset_group_id",
        "exercise_type",
        "notes",
        "sets"
      ],
      "properties": {
        "id": { "type": "string" },
        "exercise_id": { "type": "string" },
        "exercise_name": { "type": "string" },
        "source_routine_exercise_id": { "type": ["string", "null"] },
        "superset_group_id": { "type": ["string", "null"] },
        "exercise_type": { "$ref": "#/definitions/ExerciseType" },
        "notes": { "type": ["string", "null"] },
        "sets": {
          "type": "array",
          "items": { "$ref": "#/definitions/LoggedSetBody" }
        }
      }
    },
    "WorkoutBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routine_id",
        "routine_structure_version",
        "name",
        "notes",
        "bodyweight_kg",
        "exercises"
      ],
      "properties": {
        "routine_id": { "type": ["string", "null"] },
        "routine_structure_version": { "type": ["integer", "null"] },
        "name": { "type": "string" },
        "notes": { "type": ["string", "null"] },
        "bodyweight_kg": { "type": ["number", "null"] },
        "exercises": {
          "type": "array",
          "items": { "$ref": "#/definitions/WorkoutExerciseBody" }
        }
      }
    },
    "ActiveWorkoutState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workout"],
      "properties": {
        "kind": { "const": "active" },
        "workout": { "$ref": "#/definitions/ActiveWorkoutBody" }
      }
    },
    "FinishedWorkoutState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ended_at_ms", "workout"],
      "properties": {
        "kind": { "const": "finished" },
        "ended_at_ms": { "type": "integer", "minimum": 0 },
        "workout": { "$ref": "#/definitions/WorkoutBody" }
      }
    },
    "DiscardedWorkoutState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "discarded" } }
    },
    "WorkoutReplica": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workout_id", "started_at_ms", "changed_at_ms", "state"],
      "properties": {
        "workout_id": { "type": "string" },
        "started_at_ms": { "type": "integer", "minimum": 0 },
        "changed_at_ms": { "type": "integer", "minimum": 0 },
        "state": {
          "oneOf": [
            { "$ref": "#/definitions/ActiveWorkoutState" },
            { "$ref": "#/definitions/FinishedWorkoutState" },
            { "$ref": "#/definitions/DiscardedWorkoutState" }
          ]
        }
      }
    },
    "WorkoutReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workout_id", "watch_started_at_ms", "watch_changed_at_ms"],
      "properties": {
        "workout_id": { "type": "string" },
        "watch_started_at_ms": { "type": "integer", "minimum": 0 },
        "watch_changed_at_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "WorkoutMailbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "candidate", "watch_receipt"],
      "properties": {
        "protocol_version": { "type": "integer", "const": 1 },
        "candidate": {
          "oneOf": [{ "$ref": "#/definitions/WorkoutReplica" }, { "type": "null" }]
        },
        "watch_receipt": {
          "oneOf": [{ "$ref": "#/definitions/WorkoutReceipt" }, { "type": "null" }]
        }
      }
    },
    "ExerciseDto": {
      "type": "object",
      "required": ["id", "name", "exercise_type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "exercise_type": { "$ref": "#/definitions/ExerciseType" }
      }
    },
    "RoutineSetDto": {
      "type": "object",
      "required": ["id", "routine_exercise_id", "position", "set_type"],
      "properties": {
        "id": { "type": "string" },
        "routine_exercise_id": { "type": "string" },
        "position": { "type": "integer" },
        "set_type": { "type": "string", "enum": ["normal", "warmup", "dropset", "failure"] },
        "target_weight": { "type": ["number", "null"] },
        "target_reps": { "type": ["integer", "null"] },
        "target_duration_seconds": { "type": ["integer", "null"] },
        "target_distance_meters": { "type": ["number", "null"] }
      }
    },
    "RoutineExerciseDetail": {
      "type": "object",
      "required": ["id", "routine_id", "exercise_id", "position", "exercise_type", "exercise", "sets"],
      "properties": {
        "id": { "type": "string" },
        "routine_id": { "type": "string" },
        "exercise_id": { "type": "string" },
        "position": { "type": "integer" },
        "superset_group_id": { "type": ["string", "null"] },
        "exercise_type": { "$ref": "#/definitions/ExerciseType" },
        "exercise": { "$ref": "#/definitions/ExerciseDto" },
        "sets": {
          "type": "array",
          "items": { "$ref": "#/definitions/RoutineSetDto" }
        }
      }
    },
    "RoutineDetail": {
      "type": "object",
      "required": ["id", "name", "position", "exercises"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "position": { "type": "integer" },
        "exercises": {
          "type": "array",
          "items": { "$ref": "#/definitions/RoutineExerciseDetail" }
        }
      }
    },
    "PersonalRecord": {
      "type": "object",
      "required": ["id", "exercise_id", "record_type", "value", "achieved_at"],
      "properties": {
        "id": { "type": "string" },
        "exercise_id": { "type": "string" },
        "record_type": { "type": "string", "enum": ["max_weight", "max_reps", "max_volume", "est_1rm"] },
        "value": { "type": "number" },
        "logged_set_id": { "type": ["string", "null"] },
        "achieved_at": { "type": "string" }
      }
    },
    "UserProfile": {
      "type": "object",
      "required": ["name", "sex", "birth_date", "height_cm", "bodyweight_kg"],
      "properties": {
        "name": { "type": "string" },
        "sex": { "type": ["string", "null"], "enum": ["male", "female", "prefer_not_to_say", null] },
        "birth_date": { "type": ["string", "null"] },
        "height_cm": { "type": ["number", "null"] },
        "bodyweight_kg": { "type": ["number", "null"] }
      }
    },
    "SyncSnapshot": {
      "type": "object",
      "required": ["protocol_version", "routines", "personalRecords", "profile"],
      "properties": {
        "protocol_version": { "type": "integer", "const": 2 },
        "routines": {
          "type": "array",
          "items": { "$ref": "#/definitions/RoutineDetail" }
        },
        "personalRecords": {
          "type": "array",
          "items": { "$ref": "#/definitions/PersonalRecord" }
        },
        "profile": { "$ref": "#/definitions/UserProfile" }
      }
    }
  }
}
